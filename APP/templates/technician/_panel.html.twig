{# Read-only details of an appointment, performance or stay for technicians. #}
{% set p = panel %}
{% set a = p.appointment %}
{% set chip = p.performance ? 'Vorstellung' : (a ? a.type.shortLabel : 'Im Haus') %}
{# date, time and room, shown big: that is what a technician needs first #}
{% set start = a ? a.startDate : (p.performance ? p.performance.startsAt : null) %}
{% set end = a ? a.endDate : (p.performance ? p.performance.endsAt : null) %}
{% set all_day = a ? a.allDay : (p.performance ? p.performance.allDay : false) %}
{% set room = a ? a.room : (p.performance ? p.performance.room : (p.production ? p.production.stayRoom : null)) %}
<div class="panel-head">
    <div class="top">
        <a class="btn btn-ghost btn-sm" href="{{ cal_path(query, {panel: null}) }}" style="padding-left:6px">{{ ux_icon('lucide:arrow-left') }} Meine Einsätze</a>
        <span class="row" style="gap:6px">
            {% if p.production and p.production.tentative %}<span class="badge badge-warn">Vielleicht</span>{% endif %}
            <span class="badge">{{ chip }}</span>
        </span>
    </div>
    <h2 id="panel-title">{{ p.performance ? p.production.title : (a ? a.displayTitle : p.production.title) }}</h2>
    <div class="tech-facts">
        {% if start %}
            <div class="fact">{{ ux_icon('lucide:calendar') }}<strong>{{ start|de_date('EEEE, d. MMMM') }}</strong></div>
            <div class="fact">{{ ux_icon('lucide:clock') }}<strong>{{ all_day ? 'ganztägig' : start|date('H:i') ~ (end ? '–' ~ end|date('H:i') : '') ~ ' Uhr' }}</strong></div>
        {% elseif p.production and p.production.stayFrom %}
            <div class="fact">{{ ux_icon('lucide:house') }}<strong>im Haus {{ p.production.stayFrom|de_date('d.M.') }}{{ p.production.stayUntil ? '–' ~ p.production.stayUntil|de_date('d.M.') }}</strong></div>
        {% endif %}
        <div class="fact">{{ ux_icon('lucide:map-pin') }}<strong>{{ room ? room.name : 'ganzes Haus' }}</strong></div>
    </div>
</div>
<div class="panel-body">
    {% if p.performance and p.performance.cancelled %}<div class="note note-danger">{{ ux_icon('lucide:ban') }}<span>Abgesagt</span></div>{% endif %}

    {% if p.mine %}
        <section class="panel-section stack-sm my-assignment">
            <div class="between"><h3>Mein Einsatz</h3><span class="badge {{ p.mine.status.badgeClass }}">{{ p.mine.status.label }}</span></div>
            {% set tasks = [p.mine.lighting ? 'Licht', p.mine.sound ? 'Ton', p.mine.setup ? 'Aufbau']|filter(t => t) %}
            {% if tasks %}<p class="small">Aufgabe: {{ tasks|join(', ') }}</p>{% endif %}
            {% if not p.past %}{{ include('technician/_answer.html.twig', {assignment: p.mine}) }}{% endif %}
        </section>
    {% elseif a and a.openCallAt and not p.past and contact %}
        <section class="panel-section stack-sm">
            <h3>Technik gesucht</h3>
            <form method="post" action="{{ path('app_technician_interest_here', {id: a.id}) }}" data-turbo-frame="_top">
                <input type="hidden" name="_token" value="{{ csrf_token('technician') }}">
                <input type="hidden" name="_return" value="{{ return_url }}">
                <button class="btn btn-primary btn-sm" type="submit">{{ ux_icon('lucide:hand') }} Interesse melden</button>
            </form>
        </section>
    {% endif %}

    {% if p.assignments %}
        <section class="panel-section stack-sm">
            <h3>Technik</h3>
            {% for t in p.assignments %}
                <div class="between small">
                    <span>{{ t.contact.name }}{% set tt = [t.lighting ? 'Licht', t.sound ? 'Ton', t.setup ? 'Aufbau']|filter(x => x) %}{% if tt %} <span class="muted">· {{ tt|join(', ') }}</span>{% endif %}</span>
                    <span class="badge {{ t.status.badgeClass }}">{{ t.status.label }}</span>
                </div>
            {% endfor %}
        </section>
    {% endif %}

    {% if p.production %}
        {% set notes = p.production.techNotes %}
        {% if notes %}
            <section class="panel-section stack-sm">
                <h3>Technik-Notizen</h3>
                {% for heading, note in notes %}
                    <div><div class="small muted">{{ heading }}</div><div style="white-space:pre-line">{{ note }}</div></div>
                {% endfor %}
            </section>
        {% endif %}
        {% if p.production.files|length %}
            <section class="panel-section stack-sm">
                <h3>Dateien</h3>
                {% for file in p.production.files %}
                    <a class="file-link" href="{{ path('app_production_file_download', {id: file.id}) }}" target="_blank" rel="noopener" data-turbo="false">
                        {{ ux_icon(file.mimeType starts with 'image/' ? 'lucide:image' : 'lucide:file-text') }} <span class="grow">{{ file.originalName }}</span> <span class="small muted">{{ file.sizeLabel }}</span>
                    </a>
                {% endfor %}
            </section>
        {% endif %}
        {% if a and a.description %}
            <section class="panel-section stack-sm"><h3>Beschreibung</h3><div style="white-space:pre-line">{{ a.description }}</div></section>
        {% endif %}
    {% elseif a and a.description %}
        <section class="panel-section stack-sm"><h3>Beschreibung</h3><div style="white-space:pre-line">{{ a.description }}</div></section>
    {% endif %}

    {% if p.production %}{{ include('calendar/panel/_website_info.html.twig', {production: p.production, collapsed: true}) }}{% endif %}
</div>
