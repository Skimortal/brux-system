<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Haussystem{% endblock %} · brux</title>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <meta name="theme-color" content="#1e1e1c">
    <link rel="icon" href="{{ asset('favicon.png') }}" type="image/png">
    <script>
        // restore the side column width before the first paint (see pane_resize_controller.js)
        try { if (localStorage.getItem('brux.side.collapsed') === '1' && !/[?&]panel=/.test(location.search)) document.documentElement.dataset.side = 'collapsed'; } catch (e) {}
        try { if (localStorage.getItem('brux.theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
        try { const w = parseInt(localStorage.getItem('brux.pane.side-width'), 10); if (w > 0) document.documentElement.style.setProperty('--panel-w', Math.min(w, Math.max(300, innerWidth - 632)) + 'px'); } catch (e) {}
    </script>
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>
<body>
    {% block body %}{% endblock %}
    {{ include('layout/_toasts.html.twig') }}
</body>
</html>
