{% extends 'layout/auth.html.twig' %}

{% block title %}Neues Passwort{% endblock %}

{% block auth %}
    <h1 style="font-size:26px">Neues Passwort</h1>
    {{ form_start(form, {attr: {class: 'form'}}) }}
        {{ form_row(form.plainPassword) }}
        {{ form_row(form.plainPasswordRepeat) }}
        <button class="btn btn-primary btn-block" type="submit">Passwort speichern</button>
    {{ form_end(form) }}
{% endblock %}
