{% extends 'layout/auth.html.twig' %}

{% block title %}Passwort vergessen{% endblock %}

{% block auth %}
    <div class="stack-sm">
        <h1 style="font-size:26px">Passwort vergessen</h1>
        <p class="muted">Wir schicken dir einen Link, mit dem du ein neues Passwort setzen kannst.</p>
    </div>
    {{ form_start(form, {attr: {class: 'form'}}) }}
        {{ form_row(form.email) }}
        <button class="btn btn-primary btn-block" type="submit">Link senden</button>
    {{ form_end(form) }}
    <a href="{{ path('app_login') }}" class="small">Zurück zur Anmeldung</a>
{% endblock %}
