{% extends 'layout/page.html.twig' %}
{% set is_new = production.id is null %}

{% block title %}{{ is_new ? 'Neue Produktion' : production.title }}{% endblock %}
{% block content %}
<div class="page">
    <div class="crumbs small muted" style="margin-bottom:10px"><a href="{{ path('app_production_index') }}">Produktionen</a> /</div>
    {% set has_text = production.contentHtml or production.excerptHtml %}
    <header class="prod-hero{{ production.postThumbnailUrl ? ' has-image' : '' }}">
        {% if production.postThumbnailUrl %}
            <div class="prod-hero-image"><img src="{{ production.postThumbnailUrl }}" alt="" onerror="this.parentElement.remove()"></div>
        {% endif %}
        <div class="prod-hero-body">
            <div class="prod-hero-top">
                <div class="stack-sm">
                    <h1>{{ is_new ? 'Neue Produktion' : production.title }}</h1>
                    {% if not is_new %}
                        <div class="row-wrap">
                            {% if production.fromWordPress %}<span class="badge badge-accent">WordPress-ID {{ production.externalId }}</span>{% else %}<span class="badge">eigene Produktion</span>{% endif %}
                            {% for label in production.requirementLabels %}<span class="badge badge-square">{{ label }}</span>{% endfor %}
                            {% if production.syncedAt %}<span class="small muted">zuletzt importiert {{ production.syncedAt|de_date('d.M.y HH:mm') }}</span>{% endif %}
                        </div>
                    {% endif %}
                </div>
                {% if production.permalink %}<a class="btn" href="{{ production.permalink }}" target="_blank" rel="noopener">{{ ux_icon('lucide:globe') }} Auf Website ansehen</a>{% endif %}
            </div>
            {% if has_text %}
                <div class="expandable" data-controller="expand">
                    <div class="expandable-text about-text" data-expand-target="text">{{ include('production/_about.html.twig') }}</div>
                    <button type="button" class="btn btn-ghost btn-sm expandable-toggle" data-expand-target="button" data-action="expand#toggle" hidden>Mehr anzeigen {{ ux_icon('lucide:chevron-down') }}</button>
                </div>
            {% endif %}
        </div>
    </header>
    {{ block('page') }}
</div>
{% endblock %}

{% block page %}
{% import 'production/_rows.html.twig' as rows %}
<div class="grid-main-side">
    <div class="stack-lg">
        {% if production.lastPushError %}
            <div class="note note-danger">{{ ux_icon('lucide:triangle-alert') }}<span>Letzte Übertragung an die Website fehlgeschlagen: {{ production.lastPushError }}</span></div>
        {% endif %}
        {{ form_start(form, {attr: {class: 'stack-lg', novalidate: 'novalidate', enctype: 'multipart/form-data'}}) }}
            {% set wp_locked = form.title.vars.disabled %}
            <section class="card">
                <div class="card-head">
                    <h2>Website-Inhalt</h2>
                    {% if production.fromWordPress %}<span class="badge {{ wp_locked ? 'badge-accent' : 'badge-ok' }}">{{ ux_icon(wp_locked ? 'lucide:lock' : 'lucide:check') }} {{ wp_locked ? 'wird in WordPress gepflegt' : 'hier gepflegt' }}</span>{% endif %}
                </div>
                <div class="card-body form">
                    {% if wp_locked %}
                        <div class="note">{{ ux_icon('lucide:lock') }}<span>Titel, Texte, Bild und Preise kommen derzeit von der Website und werden beim Import überschrieben. Sobald dieses System führend ist, sind die Felder hier bearbeitbar.</span></div>
                    {% endif %}
                    {{ form_row(form.title) }}
                    {{ form_row(form.permalink) }}
                    <div class="image-field">
                        <div class="image-field-preview">
                            {% if production.postThumbnailUrl %}<img src="{{ production.postThumbnailUrl }}" alt="" onerror="this.remove()">{% else %}<span class="muted">{{ ux_icon('lucide:image') }}</span>{% endif %}
                        </div>
                        <div class="stack grow">
                            {{ form_row(form.postThumbnailUrl) }}
                            {{ form_row(form.imageFile) }}
                        </div>
                    </div>
                    {{ form_row(form.excerptHtml) }}
                    {{ form_row(form.contentHtml, {help: wp_locked ? null : 'Absätze und einfache Formatierung (<p>, <strong>, <em>, <a>) werden auf der Website übernommen.'}) }}
                    {{ rows.prices(form.priceList, 'Noch keine Preise.') }}
                </div>
            </section>

            <section class="card">
                <div class="card-head"><h2>Technik &amp; Bühne</h2></div>
                <div class="card-body form">
                    <div class="field">
                        <span class="field-label">Benötigt</span>
                        <div class="toggles">
                            {% for field in [form.needsLightingTechnician, form.needsSoundTechnician, form.needsSetupTechnician] %}
                                <span class="toggle">{{ form_widget(field) }}<label for="{{ field.vars.id }}">{{ field.vars.label }}</label></span>
                            {% endfor %}
                        </div>
                    </div>
                    {{ form_row(form.grandstand) }}
                </div>
            </section>

            <section class="card" data-controller="collection" data-collection-index-value="{{ form.contactPersons|length }}" data-collection-placeholder-value="__cp__">
                <div class="card-head">
                    <h2>Ansprechpersonen</h2>
                    <button type="button" class="btn btn-sm" data-action="collection#add">{{ ux_icon('lucide:plus') }} Person</button>
                </div>
                <div class="card-body">
                    <div class="rows" data-collection-target="list">
                        {% for f in form.contactPersons %}{{ rows.contact(f) }}{% endfor %}
                    </div>
                    <p class="muted small" data-collection-target="empty" {% if form.contactPersons|length %}hidden{% endif %}>Noch keine Ansprechpersonen. Sie können im Kalender einzelnen Vorstellungen zugeordnet werden.</p>
                    <template data-collection-target="prototype">{{ rows.contact(form.contactPersons.vars.prototype) }}</template>
                </div>
            </section>

            <section class="card" data-controller="collection" data-collection-index-value="{{ form.technicians|length }}" data-collection-placeholder-value="__pt__">
                <div class="card-head">
                    <h2>Technik der Produktion</h2>
                    <button type="button" class="btn btn-sm" data-action="collection#add">{{ ux_icon('lucide:plus') }} Person</button>
                </div>
                <div class="card-body">
                    <p class="muted small" style="margin-bottom:10px">Techniker:innen, die die Produktion selbst mitbringt.</p>
                    <div class="rows" data-collection-target="list">
                        {% for f in form.technicians %}{{ rows.technician(f) }}{% endfor %}
                    </div>
                    <template data-collection-target="prototype">{{ rows.technician(form.technicians.vars.prototype) }}</template>
                    <p data-collection-target="empty" hidden></p>
                </div>
            </section>
            {% do form.contactPersons.setRendered %}
            {% do form.technicians.setRendered %}
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">{{ ux_icon('lucide:save') }} Speichern</button>
                <a class="btn btn-ghost" href="{{ path('app_production_index') }}">Zurück</a>
            </div>
        {{ form_end(form) }}

        {% if not is_new and is_granted('ROLE_ADMIN') %}
            <form method="post" action="{{ path('app_production_delete', {id: production.id}) }}" data-turbo-confirm="Produktion mit allen Vorstellungen löschen? Kommt sie aus WordPress, wird sie beim nächsten Import wieder angelegt.">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-production-' ~ production.id) }}">
                <button class="btn btn-sm btn-danger" type="submit">{{ ux_icon('lucide:trash-2') }} Produktion löschen</button>
            </form>
        {% endif %}
    </div>

    <aside class="stack-lg">
        {% if cal %}
            <turbo-frame id="production-calendar" data-turbo-action="advance">
                <section class="card prod-cal">
                    <div class="card-head">
                        <h2>Kalender</h2>
                        <div class="row">
                            <a class="btn btn-icon btn-sm" href="{{ path('app_production_show', {id: production.id, monat: month.modify('-1 month')|date('Y-m')}) }}" aria-label="Voriger Monat">{{ ux_icon('lucide:chevron-left') }}</a>
                            <span class="prod-cal-title">{{ month|de_date('MMMM y') }}</span>
                            <a class="btn btn-icon btn-sm" href="{{ path('app_production_show', {id: production.id, monat: month.modify('+1 month')|date('Y-m')}) }}" aria-label="Nächster Monat">{{ ux_icon('lucide:chevron-right') }}</a>
                        </div>
                    </div>
                    {{ include('calendar/_month.html.twig', {query: cal.query, link_frame: '_top', panel_link: path('app_production_show', {id: production.id, monat: month|date('Y-m')}) ~ '&panel='}) }}
                    <div class="card-foot small"><a href="{{ path('app_calendar', {view: 'month', date: month|date('Y-m-d')}) }}" data-turbo-frame="_top">Im großen Kalender öffnen</a></div>
                </section>
            </turbo-frame>
        {% endif %}
        {% if not is_new %}
            <section class="card">
                <div class="card-head">
                    <h2>Vorstellungen <span class="badge">{{ performances|length }}</span></h2>
                    {% if can_add_performance %}
                        <a class="btn btn-sm" href="{{ path('app_production_show', {id: production.id, monat: month|date('Y-m'), panel: 'pe-new', production: production.id, from: performances ? (performances|last).id : null}) }}">{{ ux_icon('lucide:plus') }} Vorstellung</a>
                    {% endif %}
                </div>
                <div>
                    {% for pe in performances %}
                        {% set past = pe.date and pe.date < today %}
                        <a class="key-row{{ panel and panel.performance.id == pe.id ? ' is-selected' }}" href="{{ path('app_production_show', {id: production.id, panel: 'pe-' ~ pe.id, monat: pe.date ? pe.date|date('Y-m') : null}) }}" style="{{ past ? 'opacity:.55' }}">
                            <span class="grow">
                                <span class="name" style="display:block">{{ pe.startsAt ? pe.startsAt|de_date('EE d. MMM y') : 'ohne Datum' }}{{ pe.timeFrom ? ' · ' ~ pe.timeFrom : '' }}</span>
                                <span class="line" style="display:block">{{ pe.room ? pe.room.name : 'ohne Raum' }}{% if pe.quota %} · {{ pe.seatsTaken ?? 0 }}/{{ pe.quota }} reserviert{% endif %}{% if pe.appointment %} · Besetzung{% endif %}</span>
                            </span>
                            {{ ux_icon('lucide:chevron-right') }}
                        </a>
                    {% else %}
                        <div class="empty">Noch keine Vorstellungen.</div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </aside>
</div>

{% if panel %}
    {# same panel as in the calendar, docked on the right #}
    <aside class="cal-side prod-drawer" aria-labelledby="panel-title">
        <div class="side-content has-panel is-wide">
            {{ include('calendar/panel/_' ~ panel.kind ~ '.html.twig', {close_url: path('app_production_show', {id: production.id, monat: month|date('Y-m')})}) }}
        </div>
    </aside>
{% endif %}
{% endblock %}
