{% extends 'layout/app.html.twig' %}

{% block title %}Kalender{% endblock %}
{% block main_class %}cal-page{% endblock %}

{% block content %}
<div class="cal-shell">
    <section class="cal-main">
        <turbo-frame id="calendar" data-turbo-action="advance">
            {{ include('calendar/_toolbar.html.twig') }}
            <div class="cal-board" data-controller="quick-create scroll-keeper"
                 data-quick-create-appointment-url-value="{{ cal_path(query, {panel: 'a-new'}) }}"
                 data-quick-create-loan-url-value="{{ cal_path(query, {panel: 'kl-new'}) }}"
                 data-quick-create-performance-url-value="{{ cal_path(query, {panel: 'pe-new'}) }}"
                 data-quick-create-production-url-value="{{ path('app_production_new') }}"
                 data-action="click->quick-create#open">
                {% if query.effectiveLayout == 'split' %}
                    {{ include('calendar/_split.html.twig') }}
                {% elseif query.view == 'month' %}
                    {{ include('calendar/_month.html.twig') }}
                {% else %}
                    {{ include('calendar/_lanes.html.twig') }}
                {% endif %}
                {{ include('calendar/_quick_create.html.twig') }}
            </div>
        </turbo-frame>
    </section>
    <div class="pane-handle" role="separator" aria-orientation="vertical" aria-label="Breite der rechten Spalte ändern (Doppelklick: zurücksetzen)" tabindex="0"
         title="Ziehen, um die Breite zu ändern · Doppelklick setzt zurück"
         data-controller="pane-resize"
         data-action="pointerdown->pane-resize#start pointermove->pane-resize#move pointerup->pane-resize#end pointercancel->pane-resize#end dblclick->pane-resize#reset keydown->pane-resize#key"></div>
    {% set wide = panel and panel.kind in ['appointment', 'performance', 'performance_new', 'loan'] %}
    <turbo-frame id="side" class="cal-side" data-turbo-action="advance">
        {# frame navigation swaps only the content, so the state markers live on this wrapper #}
        <div class="side-content{{ panel ? ' has-panel' : '' }}{{ wide ? ' is-wide' : '' }}">
            {% if panel %}
                {{ include('calendar/panel/_' ~ panel.kind ~ '.html.twig') }}
            {% else %}
                {{ include('calendar/_home.html.twig') }}
            {% endif %}
        </div>
    </turbo-frame>
</div>
{% endblock %}
