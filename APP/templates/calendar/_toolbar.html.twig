{% set groups = enum_cases('App\\Calendar\\EntryGroup') %}
<div class="cal-toolbar">
    <div class="cal-nav">
        <a class="btn btn-icon btn-sm" href="{{ cal_path(query, {date: query.previousDate|date('Y-m-d')}) }}" aria-label="Zurück">{{ ux_icon('lucide:chevron-left') }}</a>
        <a class="btn btn-sm" href="{{ cal_path(query, {date: null}) }}">Heute</a>
        <a class="btn btn-icon btn-sm" href="{{ cal_path(query, {date: query.nextDate|date('Y-m-d')}) }}" aria-label="Weiter">{{ ux_icon('lucide:chevron-right') }}</a>
    </div>
    <h1>{{ cal.title }}</h1>
    <div class="grow"></div>
    <nav class="seg-links" aria-label="Ansicht">
        {% for key, label in constant('App\\Calendar\\CalendarQuery::VIEWS') %}
            <a href="{{ cal_path(query, {view: key}) }}" {% if query.view == key %}aria-current="true"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>
    <nav class="seg-links" aria-label="Aufteilung">
        {% for key, label in query.availableLayouts %}
            <a href="{{ cal_path(query, {layout: key}) }}" {% if query.effectiveLayout == key %}aria-current="true"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>
    <button type="button" class="btn btn-icon btn-sm side-toggle" data-controller="side-toggle" data-action="side-toggle#toggle" aria-label="Rechte Spalte ein-/ausblenden" title="Rechte Spalte ein-/ausblenden">{{ ux_icon('lucide:layout-list') }}</button>
    <button type="button" class="btn btn-primary btn-sm" data-action="quick-create#openDefault" data-date="{{ query.view == 'day' or not ('now'|date('Y-m-d') >= query.rangeStart|date('Y-m-d') and 'now'|date('Y-m-d') < query.rangeEnd|date('Y-m-d')) ? query.date|date('Y-m-d') : 'now'|date('Y-m-d') }}">{{ ux_icon('lucide:plus') }} Neu</button>
</div>
<div class="cal-filters">
    {% for group in groups %}
        {% set off = query.isHidden(group) %}
        <a class="chip{{ off ? ' is-off' : '' }}" href="{{ path('app_calendar', query.toggleParams(group)) }}" aria-pressed="{{ off ? 'false' : 'true' }}" title="{{ off ? 'Einblenden' : 'Ausblenden' }}">
            <span class="chip-swatch swatch-{{ group.colorKey }}"></span>{{ group.label }}
        </a>
    {% endfor %}
    <div class="grow"></div>
    <form class="report-form" method="get" action="{{ path('app_cleaning_report') }}" target="_blank" data-turbo="false" title="Monatsliste der Reinigung als PDF">
        {% if cleaning_contacts|length > 1 %}
            <select class="input" name="contact" aria-label="Reinigungskraft">
                {% for c in cleaning_contacts %}<option value="{{ c.id }}">{{ c.name }}</option>{% endfor %}
            </select>
        {% elseif cleaning_contacts|length == 1 %}
            <input type="hidden" name="contact" value="{{ cleaning_contacts|first.id }}">
        {% endif %}
        <input class="input" type="month" name="month" value="{{ query.date|date('Y-m') }}" required aria-label="Monat">
        <button class="chip" type="submit" {% if cleaning_contacts is empty %}disabled title="Keine Kontakte mit der Rolle Reinigung"{% endif %}>{{ ux_icon('lucide:spray-can') }} Monatsliste</button>
    </form>
    <form method="post" action="{{ path('app_wordpress_sync') }}" data-turbo-frame="_top" data-controller="busy">
        <input type="hidden" name="_token" value="{{ csrf_token('wordpress-sync') }}">
        <input type="hidden" name="_return" value="{{ return_url }}">
        <button class="chip" type="submit" data-busy-target="button" title="Letzter Import: {{ last_sync ? last_sync|de_date('d.M.y HH:mm') : 'noch nie' }}">
            {{ ux_icon('lucide:refresh-cw') }} Veranstaltungen aus WP laden
        </button>
    </form>
</div>
