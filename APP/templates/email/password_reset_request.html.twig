{% extends 'email/_layout.html.twig' %}
{% block subject %}Passwort zurücksetzen – BRUX Haussystem{% endblock %}
{% block content %}
    <p>Hallo {{ user.firstName ?? user.email }},</p>
    <p>für dein Konto im BRUX Haussystem wurde ein neues Passwort angefordert.</p>
    {{ include('email/_button.html.twig', {url: resetUrl, label: 'Neues Passwort festlegen'}) }}
    <p>Der Link gilt bis {{ expiresAt|date('d.m.Y H:i') }} Uhr. Danach kannst du jederzeit einen neuen anfordern.</p>
    <p>Hast du das nicht angefordert, kannst du diese Mail einfach ignorieren – dein Passwort bleibt unverändert.</p>
{% endblock %}
